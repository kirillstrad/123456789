{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "runtime",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ]
}